# Copy this file to .env.local and fill in only what you want. Every provider is off until its key is set.
# Restart the app after editing.

# Shown in the greeting on the home page (optional)
LEARNER_NAME=

# Where your progress database lives (default: ./data)
# DATA_DIR=./data

# ── Free and local ─────────────────────────────────────────────
# Ollama: install from ollama.com, then `ollama pull qwen3:8b`
OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODELS=qwen3:8b,deepseek-r1:8b,gemma3:12b,llama3.1:8b

# Google Gemini (free tier for Flash models): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELS=llama-3.3-70b-versatile,qwen/qwen3-32b

# OpenRouter (models ending in :free cost nothing): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3.1:free

# Any OpenAI-compatible server, e.g. LM Studio
# CUSTOM_BASE_URL=http://localhost:1234/v1
# CUSTOM_API_KEY=
# CUSTOM_MODELS=your-model-id

# ── Paid ───────────────────────────────────────────────────────
# Anthropic Claude: Console API key from https://platform.claude.com (a Claude.ai subscription won't work)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-sonnet-5,claude-haiku-4-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODELS=gpt-5-mini

# xAI Grok
XAI_API_KEY=
# XAI_MODELS=grok-3-mini

# DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner

# Qwen via Alibaba Cloud Model Studio (DashScope)
DASHSCOPE_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODELS=qwen-plus,qwen-turbo
